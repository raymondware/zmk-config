/* SPDX-License-Identifier: MIT */
&mt { tapping-term-ms = <400>; };

/ {
    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <400>;
        quick-tap-ms = <0>;
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
    };

    macros {
        /* Release Ctrl before sending the tmux command. No shell commands. */
        tmux_previous: tmux_previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,
                       <&macro_release &kp LCTRL>, <&macro_tap &kp P>;
        };
        tmux_next: tmux_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,
                       <&macro_release &kp LCTRL>, <&macro_tap &kp N>;
        };
        tmux_zoom: tmux_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp B>,
                       <&macro_release &kp LCTRL>, <&macro_tap &kp Z>;
        };
    };
};

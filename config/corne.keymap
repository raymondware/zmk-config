#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define NUMB 3
#define SYS 4

/* Physical positions, independent of the active layer's key labels.
 *  LT4 LT3 LT2 LT1 LT0 | RT0 RT1 RT2 RT3 RT4
 *  LM4 LM3 LM2 LM1 LM0 | RM0 RM1 RM2 RM3 RM4
 *  LB4 LB3 LB2 LB1 LB0 | RB0 RB1 RB2 RB3 RB4
 *          LH2 LH1 LH0 | RH0 RH1 RH2
 */
#define LT4 0
#define LT3 1
#define LT2 2
#define LT1 3
#define LT0 4
#define RT0 5
#define RT1 6
#define RT2 7
#define RT3 8
#define RT4 9
#define LM4 10
#define LM3 11
#define LM2 12
#define LM1 13
#define LM0 14
#define RM0 15
#define RM1 16
#define RM2 17
#define RM3 18
#define RM4 19
#define LB4 20
#define LB3 21
#define LB2 22
#define LB1 23
#define LB0 24
#define RB0 25
#define RB1 26
#define RB2 27
#define RB3 28
#define RB4 29
#define LH2 30
#define LH1 31
#define LH0 32
#define RH0 33
#define RH1 34
#define RH2 35

#include "includes/behaviors.dtsi"
#include "includes/combos.dtsi"

/ {
    chosen { zmk,physical-layout = &foostan_corne_5col_layout; };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
                &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSHIFT F &kp G        &kp H        &kp J        &kp K        &kp L        &mt LS(LC(LA(LGUI))) SEMICOLON
                &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp SLASH
                &kp LCTRL    &mo SYM      &kp SPACE                             &kp ENTER    &mo NUMB     &kp BACKSPACE
            >;
        };

        /* Mac clipboard shortcuts; tmux macros assume its default Ctrl-B prefix.
         * Physical Z returns to BASE on every non-base layer, even if latched.
         */
        navigation_layer {
            bindings = <
                &kp ESC      &kp LG(Z)    &kp LG(LS(Z)) &kp LG(C)   &kp LG(V)    &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp DELETE
                &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHIFT  &kp RALT     &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp BACKSPACE
                &to DEF      &tmux_previous &tmux_next &tmux_zoom &to SYS      &kp LA(LEFT) &kp LA(RIGHT) &kp TAB     &kp LS(TAB)  &caps_word
                &kp LCTRL    &mo SYM      &kp SPACE                             &kp ENTER    &mo NUMB     &kp BACKSPACE
            >;
        };

        /* Left thumb selects symbols; bracket pairs use the right index/middle.
         * Shift is still available on both layer-selection thumb positions.
         */
        symbol_layer {
            bindings = <
                &kp EXCL     &kp AT       &kp HASH     &kp DOLLAR  &kp PERCENT  &kp PLUS     &kp LBRC     &kp RBRC     &kp ASTERISK &kp AMPS
                &kp SQT      &kp DQT      &kp GRAVE    &kp TILDE   &kp UNDER    &kp EQUAL    &kp LPAR     &kp RPAR     &kp SEMICOLON &kp COLON
                &to DEF      &kp PIPE     &kp LT       &kp GT      &kp CARET    &kp MINUS    &kp LBKT     &kp RBKT     &kp SLASH    &kp BACKSLASH
                &kp LCTRL    &kp LSHIFT   &kp SPACE                             &kp ENTER    &kp RSHIFT   &kp BACKSPACE
            >;
        };

        /* Right NUM thumb leaves the left hand free for a numpad. */
        number_layer {
            bindings = <
                &kp ESC      &kp N7       &kp N8       &kp N9      &kp MINUS    &kp SLASH    &kp MINUS    &kp PLUS     &kp EQUAL    &kp ASTERISK
                &kp TAB      &kp N4       &kp N5       &kp N6      &kp N0       &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp BACKSPACE
                &to DEF      &kp N1       &kp N2       &kp N3      &kp DOT      &kp PERCENT  &kp COMMA    &kp COLON    &kp SEMICOLON &kp SLASH
                &kp LCTRL    &kp LSHIFT   &kp SPACE                             &kp ENTER    &kp RSHIFT   &kp BACKSPACE
            >;
        };

        /* No reset, bootloader or pairing-clear actions among everyday chords. */
        system_layer {
            bindings = <
                &kp F1       &kp F2       &kp F3       &kp F4      &kp F5       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10
                &kp F11      &kp F12      &kp C_BRI_DN &kp C_BRI_UP &kp LALT    &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV   &kp C_PP     &kp C_NEXT
                &to DEF      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &out OUT_USB &bt BT_SEL 3 &bt BT_SEL 4 &kp C_MUTE  &out OUT_BLE &none
                &kp LCTRL    &kp LSHIFT   &kp SPACE                             &kp ENTER    &kp RSHIFT   &kp BACKSPACE
            >;
        };
    };
};
